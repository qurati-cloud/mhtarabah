rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsFamily(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    function directoryPath(uid) {
      return /databases/$(database)/documents/directory/$(uid);
    }
    function validDirectory(entry) {
      return entry.keys().hasOnly(['email','parentName','phone','country','source','registeredAt'])
        && entry.email is string && entry.email.size() > 0 && entry.email.size() <= 254
        && entry.get('parentName', '') is string && entry.get('parentName', '').size() <= 80
        && entry.get('phone', '') is string
        && (entry.get('phone', '') == '' || entry.phone.matches('[+][1-9][0-9]{6,14}'))
        && (entry.get('country', '') == '' || entry.country.matches('[A-Z]{2}'))
        && (!('registeredAt' in entry) || (entry.registeredAt is timestamp && entry.registeredAt <= request.time));
    }
    match /directory/{uid} {
      allow read: if admin() || ownsFamily(uid);
      allow create: if validDirectory(request.resource.data) && (
        (ownsFamily(uid) && request.resource.data.email == request.auth.token.email
          && request.resource.data.get('source', 'web') == 'web'
          && !request.resource.data.keys().hasAny(['parentName','phone']))
        || (admin() && request.resource.data.source == 'admin'
          && request.resource.data.registeredAt == request.time
          && request.resource.data.parentName.size() > 0 && request.resource.data.country.size() == 2)
        || (admin() && request.resource.data.keys().hasOnly(['email','parentName'])
          && request.resource.data.email == get(/databases/$(database)/documents/families/$(uid)).data.email)
      );
      allow update: if validDirectory(request.resource.data) && (
        (ownsFamily(uid) && request.resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','country','registeredAt'])
          && (!('registeredAt' in resource.data) || request.resource.data.registeredAt == resource.data.registeredAt))
        || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentName']))
      );
    }
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function ownerAdmin() { return verified() && request.auth.token.email == 'quraaty@gmail.com'; }
    function roleIs(role) { return verified() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == role; }
    function admin() { return ownerAdmin() || roleIs('admin'); }
    match /roles/{uid} {
      allow read: if ownsFamily(uid) || admin();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['role']) && request.resource.data.role in ['admin','editor','user'];
      allow delete: if admin();
    }
    match /families/{uid} {
      allow read: if ownsFamily(uid) || admin();
      allow create, update: if ownsFamily(uid) && request.resource.data.keys().hasOnly(['email']) && request.resource.data.email == request.auth.token.email;
    }
    // Family portraits are private, including from site editors and administrators.
    match /families/{uid}/avatars/{avatarId} {
      allow read, delete: if ownsFamily(uid);
      allow create, update: if ownsFamily(uid)
        && (avatarId == 'account' || (exists(profilePath(uid, avatarId))
          && !exists(deletionPath(uid, avatarId))))
        && request.resource.data.keys().hasOnly(['name','image'])
        && request.resource.data.keys().hasAll(['name','image'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 600000
        && (request.resource.data.image == '' || request.resource.data.image.matches('data:image/(png|webp|jpeg);base64,[A-Za-z0-9+/=]+'));
    }
    match /libraryBooks/{bookId} {
      allow read: if admin() || resource.data.published == true;
      allow write: if admin();
    }
    match /libraryBooks/{bookId}/assets/{assetId} {
      allow read: if admin() || (get(/databases/$(database)/documents/libraryBooks/$(bookId)).data.published == true
        && assetId in get(/databases/$(database)/documents/libraryBooks/$(bookId)).data.get('assetIds', []));
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['payload'])
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 700000;
      allow delete: if admin();
    }
    match /librarySeries/{seriesId} {
      allow read: if admin() || resource.data.published == true;
      allow write: if admin();
    }
    match /siteContent/{key} {
      allow read: if true;
      allow write: if (admin() || roleIs('editor'));
    }
    match /runnerWorldRecords/{mode} {
      function validRecord() {
        let score = request.resource.data;
        return mode in ['solo', 'duo']
          && score.keys().hasOnly(['distance','stars'])
          && score.distance is int && score.distance >= 1 && score.distance <= 10000000
          && score.stars is int && score.stars >= 0 && score.stars <= score.distance * 2;
      }
      function runnerPlayer() {
        return verified() || (request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous');
      }
      allow get: if mode in ['solo', 'duo'];
      allow create: if runnerPlayer() && validRecord();
      allow update: if runnerPlayer() && validRecord()
        && request.resource.data.distance >= resource.data.distance
        && request.resource.data.stars >= resource.data.stars;
    }
    function profilePath(uid, profileId) {
      return /databases/$(database)/documents/families/$(uid)/profiles/$(profileId);
    }
    function deletionPath(uid, profileId) {
      return /databases/$(database)/documents/families/$(uid)/deletedProfiles/$(profileId);
    }
    match /families/{uid}/deletedProfiles/{profileId} {
      allow create: if ownsFamily(uid)
        && request.resource.data.keys().hasOnly(['deleted'])
        && request.resource.data.deleted == true
        && getAfter(profilePath(uid, profileId)).data.deleting == true;
    }
    match /families/{uid}/profiles/{profileId} {
      allow delete: if ownsFamily(uid) && exists(deletionPath(uid, profileId));
      allow read: if ownsFamily(uid) || admin();
      allow update: if ownsFamily(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting'])
        && request.resource.data.deleting == true
        && existsAfter(deletionPath(uid, profileId));
      function validProfile(profile) {
        return profile.keys().hasOnly(['name','firstName','lastName','gender','birthDate'])
        && profile.name is string
        && profile.name.size() > 0
        && profile.name.size() <= 80
        && (!profile.keys().hasAny(['firstName','lastName','gender','birthDate']) || (profile.keys().hasAll(['firstName','lastName','gender','birthDate']) && profile.firstName is string && profile.firstName.size() > 0 && profile.firstName.size() <= 40 && profile.lastName is string && profile.lastName.size() > 0 && profile.lastName.size() <= 40 && profile.gender in ['male','female'] && profile.birthDate is string && profile.birthDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
      }
      allow create: if !existsAfter(deletionPath(uid, profileId))
        && validProfile(request.resource.data)
        && (ownsFamily(uid) || (admin() && !exists(directoryPath(uid))
          && getAfter(directoryPath(uid)).data.source == 'admin'));
      allow update: if !existsAfter(deletionPath(uid, profileId))
        && validProfile(request.resource.data)
        && (ownsFamily(uid) || (admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','firstName','lastName'])));
      match /progress/{key} {
        allow delete: if ownsFamily(uid);
        allow read: if ownsFamily(uid);
        // Private, immutable online match history. Client-reported, not an official leaderboard.
        allow create: if ownsFamily(uid)
          && existsAfter(profilePath(uid, profileId))
          && !existsAfter(deletionPath(uid, profileId))
          && key.matches('mh-challenge-match:[A-Za-z0-9_-]{20}')
          && request.resource.data.keys().hasOnly(['value'])
          && request.resource.data.value.keys().hasOnly(['game','mode','result','distance','stars'])
          && request.resource.data.value.keys().hasAll(['game','mode','result','distance','stars'])
          && request.resource.data.value.game == 'obstacles'
          && ((request.resource.data.value.mode == 'versus'
                && request.resource.data.value.result in ['win','loss','draw'])
              || (request.resource.data.value.mode == 'team'
                && request.resource.data.value.result == 'team'))
          && request.resource.data.value.distance is int
          && request.resource.data.value.distance >= 0
          && request.resource.data.value.distance <= 10000000
          && request.resource.data.value.stars is int
          && request.resource.data.value.stars >= 0
          && request.resource.data.value.stars <= 2000000;
        allow create, update: if ownsFamily(uid)
          && existsAfter(profilePath(uid, profileId))
          && !existsAfter(deletionPath(uid, profileId))
          && (key in ['mh-library-v1', 'mh_capitals_v1', 'mh_math_v1', 'mh_word_problems_v1',
                      'mh_obstacles_v1', 'mh_flight_endless_record_v1',
                      'mh_submarine_endless_record_v1', 'mh_runner_record_v1', 'mh-prayer-v1', 'mh-awrad-v1']
              || key.matches('mh-daily-v1:[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          && request.resource.data.keys().hasOnly(['value'])
          && (request.resource.data.value is list || request.resource.data.value is map);
      }
    }
  }
}
