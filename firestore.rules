rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsFamily(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    match /families/{uid}/profiles/{profileId} {
      allow read: if ownsFamily(uid);
      allow create, update: if ownsFamily(uid)
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      match /progress/{key} {
        allow read: if ownsFamily(uid);
        allow create, update: if ownsFamily(uid)
          && exists(/databases/$(database)/documents/families/$(uid)/profiles/$(profileId))
          && (key in ['mh_capitals_v1', 'mh_math_v1', 'mh_word_problems_v1',
                      'mh_obstacles_v1', 'mh_flight_endless_record_v1',
                      'mh_submarine_endless_record_v1', 'mh-prayer-v1', 'mh-awrad-v1']
              || key.matches('mh-daily-v1:[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          && request.resource.data.keys().hasOnly(['value'])
          && (request.resource.data.value is list || request.resource.data.value is map);
      }
    }
  }
}
